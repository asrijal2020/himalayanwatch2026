FLASK_APP=app.py
FLASK_DEBUG=1
DATABASE_PATH=instance/glacier_monitor.db
# Backward-compatible local fallback when scoped keys below are empty.
WRITE_API_KEY=
# Production deployments should separate device/gateway ingestion from operator actions.
INGEST_API_KEY=
OPERATOR_API_KEY=
# Public metadata search endpoint; no credentials are required for bounded STAC searches.
SENTINEL_STAC_URL=https://stac.dataspace.copernicus.eu/v1/search

# Ingestion: direct stores locally; eventhub publishes for a separate consumer.
INGESTION_MODE=direct
AZURE_EVENTHUB_NAMESPACE=
AZURE_EVENTHUB_NAME=himalayawatch-events
AZURE_EVENTHUB_CONSUMER_GROUP=himalayawatch-processors
# Local-development fallback only. Prefer managed identity in Azure.
AZURE_EVENTHUB_CONNECTION_STRING=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_ARCHIVE_STORAGE_ACCOUNT_URL=
AZURE_ARCHIVE_CONTAINER=raw-events
AZURE_CHECKPOINT_STORAGE_ACCOUNT_URL=
AZURE_CHECKPOINT_CONTAINER=eventhub-checkpoints

# End-user delivery remains disabled until an authorized alert is queued.
AZURE_COMMUNICATION_ENDPOINT=
AZURE_SMS_SENDER=
AZURE_EMAIL_SENDER=
# Local-development fallback only. Prefer managed identity in Azure.
AZURE_COMMUNICATION_CONNECTION_STRING=
NOTIFICATION_WEBHOOK_SECRET=
NOTIFICATION_TIMEOUT_SECONDS=10
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_WORKERS=4
